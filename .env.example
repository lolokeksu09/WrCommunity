# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://wrcommunity:replace-with-local-password@127.0.0.1:5432/wrcommunity
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
LFG_CONTACT_KEY=
MEDIA_DIR=./media
MEDIA_STORAGE_DIR=./media
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Use true for external STARTTLS SMTP (false only for local Mailpit).
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WrCommunity <no-reply@example.invalid>
WORKER_HEARTBEAT_FILE=/tmp/wrc-worker-heartbeat
# Production Compose values. Use URL-safe POSTGRES_PASSWORD in DATABASE_URL.
DOMAIN=
# Change only if this private Docker range conflicts with your host networks.
BACKEND_SUBNET=172.30.60.0/24
# Direct local development does not trust forwarded IP headers.
TRUST_PROXY_CIDR=
POSTGRES_USER=wrcommunity
POSTGRES_DB=wrcommunity
POSTGRES_PASSWORD=
# Production SMTP requires an authenticated external provider. Local Mailpit is optional.
